# Server-only — never sent to the browser. Where the Laravel API actually
# lives. In production this is your Laravel install's URL (or a subdomain,
# e.g. https://api.yourdomain.com); in local dev it's usually
# http://127.0.0.1:8000 (php artisan serve).
API_ORIGIN=http://127.0.0.1:8000

# Public — baked into the HTML (sitemap.xml, robots.txt, canonical URLs,
# Open Graph tags). Must be this app's own real public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public — where the existing React app (login, dashboards, classifieds,
# messaging, admin — everything behind auth) still lives. See README.md
# "What's NOT in this app" for why that app isn't part of this migration.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:8000
