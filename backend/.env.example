# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=mysql://mydomain:mydomain@localhost:3306/mydomain

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# WhatsApp broadcasts
# "log" records what would be sent without touching WhatsApp (safe default).
# "webjs" drives a real linked account through whatsapp-web.js.
WHATSAPP_TRANSPORT=log
# Linked sessions live here and must survive restarts, or every shop has to
# re-scan a QR code after a deploy. Never commit this directory.
WHATSAPP_SESSION_DIR=.whatsapp-sessions
# Leave blank to let Puppeteer find its own Chromium.
WHATSAPP_CHROMIUM_PATH=
# Pause between messages, plus random jitter. Sending faster is the quickest
# way to get a shop's number restricted.
WHATSAPP_SEND_DELAY_MS=8000
WHATSAPP_SEND_JITTER_MS=4000
WHATSAPP_DAILY_LIMIT=250

# Poster Studio — who writes the poster wording.
# "offline" is a built-in phrase bank: no account, no network, works today.
# "claude" calls the Anthropic API and falls back to the phrase bank on error.
POSTER_AI_PROVIDER=offline
ANTHROPIC_API_KEY=
POSTER_AI_MODEL=claude-opus-5
