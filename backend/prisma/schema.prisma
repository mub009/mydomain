// Local Business Directory & Marketplace Platform
// Enterprise domain model covering: identity, listings, search, reviews,
// lead generation, bookings, payments, and B2B services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  DEALER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id              String     @id @default(uuid()) @db.VarChar(36)
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(PENDING_VERIFICATION)
  privileges      Json? // dealer feature grants, e.g. ["MANAGE_LISTINGS","MANAGE_LEADS"]
  points          Int        @default(0) // dealer credit balance; spent when registering a business
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdById     String?    @db.VarChar(36) // staff member (dealer/admin) who created this account
  createdBy       User?      @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers    User[]     @relation("UserCreator")
  createdBusinesses Business[] @relation("BusinessCreator")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  businesses    Business[]     @relation("BusinessOwner")
  reviews       Review[]
  leads         Lead[]         @relation("LeadCustomer")
  bookings      Booking[]      @relation("BookingCustomer")
  payments      Payment[]
  rfqs          Rfq[]          @relation("RfqBuyer")
  quotes        Quote[]        @relation("QuoteSupplier")
  refreshTokens RefreshToken[]
  notifications Notification[]
  orders        Order[]
  posterDesigns PosterDesign[] @relation("PosterAuthor")

  pointTransactions      PointTransaction[] @relation("PointOwner")
  grantedPointTransactions PointTransaction[] @relation("PointGrantedBy")

  @@index([role])
  @@index([createdById])
  @@map("users")
}

enum PointTransactionType {
  ADMIN_GRANT // admin topped the dealer up
  ADMIN_DEDUCTION // admin removed points
  BUSINESS_CREATED // spent on registering a listing
}

// Ledger of every point movement, so a dealer's balance is auditable and
// admins can see what was granted and what was spent.
model PointTransaction {
  id           String              @id @default(uuid()) @db.VarChar(36)
  userId       String              @db.VarChar(36)
  user         User                @relation("PointOwner", fields: [userId], references: [id], onDelete: Cascade)
  type         PointTransactionType
  amount       Int // positive = credit, negative = debit
  balanceAfter Int
  note         String?             @db.Text
  businessId   String?             @db.VarChar(36) // set when spent on a listing
  grantedById  String?             @db.VarChar(36) // admin who granted/deducted
  grantedBy    User?               @relation("PointGrantedBy", fields: [grantedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
  @@map("point_transactions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  token     String    @unique
  userId    String    @db.VarChar(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Business Listings & Catalog
// ---------------------------------------------------------------------------

enum BusinessStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

model Category {
  id          String     @id @default(uuid()) @db.VarChar(36)
  name        String
  slug        String     @unique
  description String?    @db.Text
  iconUrl     String?
  parentId    String?    @db.VarChar(36)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  businesses  Business[]
  rfqs        Rfq[]
  posterDesigns PosterDesign[]
  createdAt   DateTime   @default(now())

  @@index([parentId])
  @@map("categories")
}

model Business {
  id               String           @id @default(uuid()) @db.VarChar(36)
  ownerId          String           @db.VarChar(36)
  owner            User             @relation("BusinessOwner", fields: [ownerId], references: [id])
  createdById      String?          @db.VarChar(36) // who registered this listing (dealer/admin/owner)
  createdBy        User?            @relation("BusinessCreator", fields: [createdById], references: [id])
  name             String
  slug             String           @unique
  description      String?          @db.Text
  categoryId       String           @db.VarChar(36)
  category         Category         @relation(fields: [categoryId], references: [id])
  status           BusinessStatus   @default(DRAFT)
  subscriptionPlan SubscriptionPlan @default(FREE)

  // Contact & location
  email        String?
  phone        String
  website      String?
  addressLine1 String
  addressLine2 String?
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(50)
  postalCode   String
  country      String  @default("IN")
  latitude     Float
  longitude    Float

  // External review profiles — used by the shop's QR board to send customers
  // straight to the right "write a review" page.
  googlePlaceId          String?        @db.VarChar(255)
  googleReviewUrl        String?        @db.Text // explicit override, else built from the place id
  instagramUsername      String?        @db.VarChar(100)
  facebookPageUrl        String?        @db.Text
  youtubeUrl             String?        @db.Text // channel or video link
  preferredReviewChannel ReviewChannel? // fallback when a board has no purpose set

  // Marketplace metadata
  logoUrl       String?
  coverImageUrl String?
  isVerified    Boolean @default(false)
  avgRating     Float   @default(0)
  reviewCount   Int     @default(0)
  leadCount     Int     @default(0)
  viewCount     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos      BusinessPhoto[]
  hours       BusinessHours[]
  services    Service[]
  reviews     Review[]
  leads       Lead[]
  bookings    Booking[]
  quotes      Quote[]         @relation("QuoteBusiness")
  rfqInvites  RfqInvite[]
  reviewScans ReviewScan[]
  reviewQrCodes ReviewQrCode[]
  site        BusinessSite?
  products    Product[]
  orders      Order[]
  whatsapp        WhatsappSession?
  contacts        Contact[]
  messageTemplates MessageTemplate[]
  campaigns       Campaign[]
  posterRenders   PosterRender[]

  @@index([categoryId])
  @@index([city, state])
  @@index([status])
  @@index([createdById])
  @@map("businesses")
}

model BusinessPhoto {
  id         String   @id @default(uuid()) @db.VarChar(36)
  businessId String   @db.VarChar(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@map("business_photos")
}

model BusinessHours {
  id         String   @id @default(uuid()) @db.VarChar(36)
  businessId String   @db.VarChar(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday .. 6=Saturday
  openTime   String // "09:00"
  closeTime  String // "18:00"
  isClosed   Boolean  @default(false)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model Service {
  id           String   @id @default(uuid()) @db.VarChar(36)
  businessId   String   @db.VarChar(36)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String?  @db.Text
  priceCents   Int
  currency     String   @default("INR")
  durationMins Int      @default(60)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  bookings Booking[]

  @@index([businessId])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Reviews & Ratings
// ---------------------------------------------------------------------------

model Review {
  id             String    @id @default(uuid()) @db.VarChar(36)
  businessId     String    @db.VarChar(36)
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String    @db.VarChar(36)
  user           User      @relation(fields: [userId], references: [id])
  rating         Int // 1-5
  title          String?
  comment        String?   @db.Text
  ownerReply     String?   @db.Text
  ownerRepliedAt DateTime?
  isFlagged      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Lead Generation
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  SEARCH
  BUSINESS_PROFILE
  CALLBACK_REQUEST
  QUOTE_REQUEST
  B2B_RFQ
}

model Lead {
  id         String     @id @default(uuid()) @db.VarChar(36)
  businessId String     @db.VarChar(36)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?    @db.VarChar(36)
  customer   User?      @relation("LeadCustomer", fields: [customerId], references: [id])
  name       String
  phone      String
  email      String?
  message    String?    @db.Text
  source     LeadSource @default(SEARCH)
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId, status])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Bookings & Appointments
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id          String        @id @default(uuid()) @db.VarChar(36)
  businessId  String        @db.VarChar(36)
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId   String        @db.VarChar(36)
  service     Service       @relation(fields: [serviceId], references: [id])
  customerId  String        @db.VarChar(36)
  customer    User          @relation("BookingCustomer", fields: [customerId], references: [id])
  scheduledAt DateTime
  status      BookingStatus @default(PENDING)
  notes       String?       @db.Text
  priceCents  Int
  currency    String        @default("INR")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment Payment?

  @@index([businessId, scheduledAt])
  @@index([customerId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentType {
  BOOKING
  SUBSCRIPTION
  LEAD_UNLOCK
}

model Payment {
  id                    String        @id @default(uuid()) @db.VarChar(36)
  userId                String        @db.VarChar(36)
  user                  User          @relation(fields: [userId], references: [id])
  bookingId             String?       @unique @db.VarChar(36)
  booking               Booking?      @relation(fields: [bookingId], references: [id])
  type                  PaymentType
  amountCents           Int
  currency              String        @default("INR")
  status                PaymentStatus @default(PENDING)
  provider              String        @default("stripe")
  providerPaymentIntent String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Business websites (drag-and-drop builder)
// ---------------------------------------------------------------------------

// A one-page site the owner edits in the builder. projectData is the editor's
// own document (source of truth); html/css are the rendered output kept for
// serving the public page without loading the editor.
// What a business's site is for. A brochure WEBSITE is built in the drag-and-
// drop editor; an ECOMMERCE site is a storefront where customers add products
// to a cart and check out, so it is rendered by the app rather than authored.
enum SiteType {
  WEBSITE
  ECOMMERCE
}

model BusinessSite {
  id          String    @id @default(uuid()) @db.VarChar(36)
  businessId  String    @unique @db.VarChar(36)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  siteType    SiteType  @default(WEBSITE)
  // Which of the built-in designs this site started from. Kept so the editor
  // can show the current choice and rebuild from the same design on reset.
  templateId  String    @default("classic") @db.VarChar(40)
  projectData Json?
  html        String?   @db.LongText
  css         String?   @db.LongText
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // Storefront settings (ECOMMERCE only).
  deliveryFeeCents       Int  @default(0)
  freeDeliveryAboveCents Int?
  acceptsOnlinePayment   Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("business_sites")
}

// ---------------------------------------------------------------------------
// Storefront catalogue & orders
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid()) @db.VarChar(36)
  businessId  String   @db.VarChar(36)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @db.VarChar(160)
  description String?  @db.Text
  priceCents  Int
  // Struck-through "was" price. Null when the item is not on offer.
  compareAtCents Int?
  currency    String   @default("INR")
  imageUrl    String?  @db.Text
  sku         String?  @db.VarChar(60)
  // Stock is only enforced when the shop opts in; many small shops do not
  // count units and would otherwise have every item read as sold out.
  trackStock  Boolean  @default(false)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([businessId, slug])
  @@index([businessId, isActive])
  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderPaymentMethod {
  COD
  ONLINE
}

model Order {
  id          String   @id @default(uuid()) @db.VarChar(36)
  businessId  String   @db.VarChar(36)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Short human-readable reference the customer quotes on the phone.
  orderNumber String   @unique @db.VarChar(24)
  // Set when the buyer happened to be signed in; storefront checkout is open
  // to guests, so the phone number is the identity that always exists.
  customerId  String?  @db.VarChar(36)
  customer    User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String   @db.VarChar(20)
  customerEmail String?
  addressLine1  String
  addressLine2  String?
  city          String
  postalCode    String?  @db.VarChar(20)
  notes         String?  @db.Text

  status        OrderStatus        @default(PENDING)
  paymentMethod OrderPaymentMethod @default(COD)

  subtotalCents    Int
  deliveryFeeCents Int    @default(0)
  totalCents       Int
  currency         String @default("INR")

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([businessId, status])
  @@index([businessId, placedAt])
  @@index([businessId, customerPhone])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.VarChar(36)
  orderId   String   @db.VarChar(36)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Kept nullable so deleting a product never destroys order history.
  productId String?  @db.VarChar(36)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot of what was actually bought, at the price charged.
  name           String
  imageUrl       String? @db.Text
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// QR review boards (send in-store customers to external review pages)
// ---------------------------------------------------------------------------

// Destinations a QR board can point at. Each business supplies its own link
// or handle per platform; a board is bound to one of these.
enum ReviewChannel {
  GOOGLE
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  WEBSITE
  DIRECTIONS // navigate to the shop, built from its coordinates
  // Our own listing. Built from the slug, so unlike the platforms above these
  // two need no setup from the shop and are available the moment it exists.
  MARKKITO // the business's Markkito details page
  MARKKITO_REVIEW // the same page with the review composer open
}

enum ReviewQrStatus {
  UNASSIGNED // printed and issued, not yet claimed by a shop
  ASSIGNED
  DISABLED // retired or lost board
}

// A pre-printed QR board issued by admin. Each carries a short code printed
// on the board itself; a shop scans it, confirms, and it becomes theirs.
model ReviewQrCode {
  id           String         @id @default(uuid()) @db.VarChar(36)
  code         String         @unique @db.VarChar(20) // e.g. MK-7F3K2A
  status       ReviewQrStatus @default(UNASSIGNED)
  // What this board is for, chosen from a list when it's issued or claimed.
  // Null falls back to the business's preferred channel.
  channel      ReviewChannel?
  batchLabel   String?        @db.VarChar(100) // grouping for a printed run
  businessId   String?        @db.VarChar(36)
  business     Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  assignedById String?        @db.VarChar(36) // who claimed it
  scanCount    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  scans ReviewScan[]

  @@index([status])
  @@index([businessId])
  @@map("review_qr_codes")
}

// One row per QR scan, so a shop can see which board and platform is working.
model ReviewScan {
  id         String        @id @default(uuid()) @db.VarChar(36)
  businessId String        @db.VarChar(36)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  qrCodeId   String?       @db.VarChar(36)
  qrCode     ReviewQrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  channel    ReviewChannel
  userAgent  String?       @db.Text
  scannedAt  DateTime      @default(now())

  @@index([businessId, scannedAt])
  @@index([qrCodeId])
  @@map("review_scans")
}

// ---------------------------------------------------------------------------
// Visitors (welcome-popup capture)
// ---------------------------------------------------------------------------

// A site visitor who shared their mobile number through the welcome popup.
// Location is only stored when the browser's permission prompt is accepted.
model Visitor {
  id           String    @id @default(uuid()) @db.VarChar(36)
  phone        String    @unique @db.VarChar(20)
  latitude     Float?
  longitude    Float?
  city         String?   @db.VarChar(100)
  consentAt    DateTime // when the visitor accepted the terms
  locationAt   DateTime? // when location was last shared
  userAgent    String?   @db.Text
  visitCount   Int       @default(1)
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
  @@map("visitors")
}

// ---------------------------------------------------------------------------
// B2B Services (RFQ / Quote marketplace)
// ---------------------------------------------------------------------------

enum RfqStatus {
  OPEN
  QUOTED
  AWARDED
  CLOSED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Rfq {
  id          String    @id @default(uuid()) @db.VarChar(36)
  buyerId     String    @db.VarChar(36)
  buyer       User      @relation("RfqBuyer", fields: [buyerId], references: [id])
  categoryId  String    @db.VarChar(36)
  category    Category  @relation(fields: [categoryId], references: [id])
  title       String
  description String    @db.Text
  quantity    Int       @default(1)
  budgetCents Int?
  currency    String    @default("INR")
  city        String    @db.VarChar(100)
  state       String    @db.VarChar(50)
  status      RfqStatus @default(OPEN)
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invites RfqInvite[]
  quotes  Quote[]

  @@index([categoryId, status])
  @@map("rfqs")
}

model RfqInvite {
  id         String   @id @default(uuid()) @db.VarChar(36)
  rfqId      String   @db.VarChar(36)
  rfq        Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  businessId String   @db.VarChar(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([rfqId, businessId])
  @@map("rfq_invites")
}

model Quote {
  id           String      @id @default(uuid()) @db.VarChar(36)
  rfqId        String      @db.VarChar(36)
  rfq          Rfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  businessId   String      @db.VarChar(36)
  business     Business    @relation("QuoteBusiness", fields: [businessId], references: [id])
  supplierId   String      @db.VarChar(36)
  supplier     User        @relation("QuoteSupplier", fields: [supplierId], references: [id])
  priceCents   Int
  currency     String      @default("INR")
  message      String?     @db.Text
  deliveryDays Int?
  status       QuoteStatus @default(SUBMITTED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([rfqId, businessId])
  @@index([rfqId])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Notifications (in-app / email / sms fan-out log)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

model Notification {
  id        String              @id @default(uuid()) @db.VarChar(36)
  userId    String              @db.VarChar(36)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  body      String              @db.Text
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// WhatsApp broadcasts
//
// A shop links its own WhatsApp number, imports the customers who gave it
// their number, writes a template and sends to them. Messages go out through
// the shop's own account, one at a time with a pause between them.
// ---------------------------------------------------------------------------

enum WhatsappStatus {
  DISCONNECTED
  // A QR code is waiting to be scanned by the shop's phone.
  AWAITING_SCAN
  CONNECTED
}

model WhatsappSession {
  id          String         @id @default(uuid()) @db.VarChar(36)
  businessId  String         @unique @db.VarChar(36)
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status      WhatsappStatus @default(DISCONNECTED)
  // The linked handset's own number, shown so a shop can tell which account
  // is connected. No credentials are stored here — the session lives on disk
  // in whatsapp-web.js's own store.
  phoneNumber String?        @db.VarChar(24)
  // Current login QR, as a data URL. Cleared the moment it is scanned.
  qrDataUrl   String?        @db.LongText
  lastError   String?        @db.Text
  connectedAt DateTime?

  // Per-shop sending controls. These live here rather than in env because the
  // right pace differs by shop: a corner shop with 40 regulars and a chain
  // with 5,000 should not share one setting. Env values seed the defaults.
  dailyLimit      Int @default(250)
  // Gap between two messages, plus random jitter on top so the spacing is not
  // machine-regular. Sending in a burst is what gets a number restricted.
  sendDelayMs     Int @default(8000)
  sendJitterMs    Int @default(4000)
  // Sending window, in whole hours of server local time. Nothing goes out
  // before the start or after the end, so a campaign left running overnight
  // does not wake customers at 3am. Equal values mean "any time".
  windowStartHour Int @default(9)
  windowEndHour   Int @default(21)
  // Mark a contact opted out when they reply STOP (or similar). On by default:
  // honouring it is both decent and the best protection for the shop's number.
  autoOptOut      Boolean @default(true)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("whatsapp_sessions")
}

enum ContactSource {
  MANUAL
  IMPORT
}

model Contact {
  id         String        @id @default(uuid()) @db.VarChar(36)
  businessId String        @db.VarChar(36)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  // Digits only, with country code — the form WhatsApp addresses need.
  phone      String        @db.VarChar(20)
  email      String?
  // Free-text grouping ("walk-in", "diwali-2026") for picking an audience.
  tag        String?       @db.VarChar(60)
  // Someone who asked to stop hearing from this shop. Never messaged again,
  // and kept rather than deleted so a re-import cannot resurrect them.
  optedOut   Boolean       @default(false)
  optedOutAt DateTime?
  source     ContactSource @default(MANUAL)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages CampaignMessage[]

  @@unique([businessId, phone])
  @@index([businessId, optedOut])
  @@index([businessId, tag])
  @@map("contacts")
}

model MessageTemplate {
  id         String   @id @default(uuid()) @db.VarChar(36)
  businessId String   @db.VarChar(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  // Supports {{name}} and {{business}} placeholders, filled per recipient.
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaigns Campaign[]

  @@index([businessId])
  @@map("message_templates")
}

enum CampaignStatus {
  DRAFT
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id         String           @id @default(uuid()) @db.VarChar(36)
  businessId String           @db.VarChar(36)
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  templateId String?          @db.VarChar(36)
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Snapshot of the wording actually used, so editing a template later never
  // rewrites what was already sent.
  body       String           @db.Text
  status     CampaignStatus   @default(DRAFT)

  totalCount   Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages CampaignMessage[]

  @@index([businessId, status])
  @@map("campaigns")
}

enum CampaignMessageStatus {
  PENDING
  SENT
  FAILED
  // Recipient opted out between queueing and sending.
  SKIPPED
}

model CampaignMessage {
  id         String                @id @default(uuid()) @db.VarChar(36)
  campaignId String                @db.VarChar(36)
  campaign   Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String?               @db.VarChar(36)
  contact    Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Snapshots, so the log stands on its own if a contact is later removed.
  name       String
  phone      String                @db.VarChar(20)
  body       String                @db.Text
  status     CampaignMessageStatus @default(PENDING)
  error      String?               @db.Text
  attempts   Int                   @default(0)
  sentAt     DateTime?

  @@index([campaignId, status])
  @@map("campaign_messages")
}

// ---------------------------------------------------------------------------
// Poster Studio
// ---------------------------------------------------------------------------
// Admin designs a poster once; every business renders it with their own logo,
// name and contact number substituted in. Nothing is stored per business —
// the artwork is generated on demand from the design plus the listing.

enum PosterSize {
  SQUARE // 1080x1080 — feed post
  PORTRAIT // 1080x1350 — feed post, taller
  STORY // 1080x1920 — status / story
}

model PosterDesign {
  id          String     @id @default(uuid()) @db.VarChar(36)
  name        String
  description String?    @db.Text
  layout      String     @default("artwork") @db.VarChar(50) // registry id
  palette     String     @default("crimson") @db.VarChar(50)
  size        PosterSize @default(PORTRAIT)

  // Wording. May contain {{business}}, {{phone}}, {{city}} … placeholders,
  // which are filled per business at render time. Optional: a poster whose
  // artwork already carries its message needs none of it.
  headline    String? @db.Text
  subheadline String? @db.Text
  ctaText     String? @db.Text
  badgeText   String? @db.VarChar(60) // corner flash, e.g. "30% OFF"
  footnote    String? @db.Text

  backgroundImageUrl String? @db.Text

  // A finished poster supplied by a designer, uploaded through the admin
  // panel. When set, the layouts stop drawing a composition of their own and
  // the artwork fills the poster, with only the header and footer bands laid
  // over it. LongText because an uploaded file is stored inline as a data URI
  // — this project has no object storage.
  artworkUrl String? @db.LongText
  // The two strips composited over the artwork. Placeholders as everywhere
  // else, so one uploaded design still carries each shop's own details.
  headerText String? @db.Text
  footerText String? @db.Text
  // Off by default: a strip laid across a designer's poster frames their work
  // rather than joining it. Details belong in the artwork — see svgTemplate.ts.
  showHeader Boolean @default(false)
  showFooter Boolean @default(false)
  // Where the shop's own logo sits on the artwork, and how big. "header"
  // keeps it inside the top strip; the corner values float it over the
  // design itself, for artwork that left a space for it.
  logoPosition String  @default("header") @db.VarChar(20)
  logoScale    Float   @default(1)

  // How the two strips sit on the artwork, and in what colour. Left null the
  // colours fall back to the palette; the editor fills them by sampling the
  // uploaded image, so the bands belong to the design rather than to a theme
  // chosen separately from it.
  bandStyle     String  @default("gradient") @db.VarChar(20)
  bandColor     String? @db.VarChar(9)
  bandTextColor String? @db.VarChar(9)

  // Targeting. Null on both means every published business sees it.
  categoryId String?   @db.VarChar(36)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  city       String?   @db.VarChar(100)

  isPublished Boolean @default(false)

  // The prompt this poster came from, kept with the poster rather than thrown
  // away: it is the record of what was asked for, and the starting point for
  // regenerating or reworking the design later.
  aiPrompt String? @db.Text
  aiEngine String? @db.VarChar(40) // "offline" | "claude" | null when hand-written

  createdById String   @db.VarChar(36)
  createdBy   User     @relation("PosterAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  renders PosterRender[]

  @@index([isPublished, categoryId])
  @@map("poster_designs")
}

// One row per (design, business) that has actually been downloaded — the
// One row per (design, business) that has actually been downloaded — the
// usage report, not a cache of the artwork.
model PosterRender {
  id         String   @id @default(uuid()) @db.VarChar(36)
  designId   String   @db.VarChar(36)
  design     PosterDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  businessId String   @db.VarChar(36)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  downloads  Int      @default(0)
  lastAt     DateTime @default(now())

  // The finished poster for this shop. Compositing is cheap enough to redo on
  // demand, but a generated image costs money and seconds, so once one exists
  // it is kept and reused until the shop asks for a new one.
  imageUrl    String?   @db.LongText
  engine      String?   @db.VarChar(20)
  generatedAt DateTime?

  @@unique([designId, businessId])
  @@index([businessId])
  @@map("poster_renders")
}
