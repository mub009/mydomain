APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — matches the docker-compose MySQL instance used by the Node
# backend (same database shape, so either backend can point at the same
# server/credentials). Swap to sqlite below for a zero-setup local start.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mydomain
DB_USERNAME=mydomain
DB_PASSWORD=mydomain
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CLIENT_ORIGIN=http://localhost:5173

# JWT — must match between deploys/restarts or existing access tokens and
# refresh tokens stop validating.
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DigitalOcean Spaces — where uploaded business photos/logos, product
# images, and (once ported) poster artwork are stored. Create a Space
# and a Spaces API key pair in the DO dashboard, then fill these in —
# see README "Image uploads (DigitalOcean Spaces)". Uploads 500 with
# INTERNAL_ERROR until these are set.
DO_SPACES_KEY=
DO_SPACES_SECRET=
# The region code you picked when creating the Space, e.g. blr1, sgp1, nyc3.
DO_SPACES_REGION=
# Your Space's exact name.
DO_SPACES_BUCKET=
# The region's Spaces endpoint — same region code as above.
DO_SPACES_ENDPOINT=https://${DO_SPACES_REGION}.digitaloceanspaces.com
# The Space's CDN subdomain (Space settings -> Enable CDN), NOT the raw
# endpoint above — this is what public image URLs are built from.
DO_SPACES_CDN_ENDPOINT=https://${DO_SPACES_BUCKET}.${DO_SPACES_REGION}.cdn.digitaloceanspaces.com

VITE_APP_NAME="${APP_NAME}"
