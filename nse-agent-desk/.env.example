# Optional: real model calls for the agents' "AI notes". Server-side only.
# Set ONE of these. NVIDIA has free developer keys at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
ANTHROPIC_API_KEY=
STOCK_AGENT_MODEL=claude-opus-5-5
# If both keys are set, choose: nvidia | anthropic (default: nvidia)
AI_PROVIDER=

# Market data when "Demo data" is switched off.
#   yahoo = Yahoo Finance daily bars (unofficial, end-of-day, NOT real-time NSE data)
#   none  = no provider; the app always uses demo data
MARKET_DATA_PROVIDER=yahoo

# News for the Morning Session agent when "Demo data" is off.
#   google = Google News RSS search (headlines matched to Nifty 50 company names)
#   none   = no news; agents score on prices only
NEWS_PROVIDER=google

# Morning Session: run the whole team automatically on NSE trading days.
MORNING_SESSION_ENABLED=true
MORNING_SESSION_TIME=09:00
MORNING_SESSION_DEMO=false
# Lets an external cron call POST /api/session (Authorization: Bearer <token>).
SESSION_TRIGGER_TOKEN=

# Mubashir's size filter and size bands, in ₹ crore (approximate; SEBI/AMFI rank by size).
MIN_MARKET_CAP_CR=300
MID_CAP_MIN_CR=30000
LARGE_CAP_MIN_CR=100000
# Market cap + EPS source when "Demo data" is off: yahoo | none
FUNDAMENTALS_PROVIDER=yahoo
# Which list the 9 AM session scans: large | mid | small | all
MORNING_SESSION_UNIVERSE=all

# Position follow-up: check tracked trades and alert on loss / stop-loss / exit area.
POSITION_MONITOR_ENABLED=true
POSITION_CHECK_MINUTES=5
# Optional phone alerts through a Telegram bot (create one with @BotFather; get your chat id from @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Diversification limits (% of the money), used by the Portfolio balance check.
NEXT_PUBLIC_MAX_SECTOR_PCT=30
NEXT_PUBLIC_MAX_STOCK_PCT=20
NEXT_PUBLIC_MAX_SMALLCAP_PCT=30
